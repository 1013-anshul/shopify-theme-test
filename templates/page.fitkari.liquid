  --display:var(--font-display,"Bree Serif",Georgia,serif); --body:var(--font-body,"Mulish","Helvetica Neue",system-ui,sans-serif);
  --gutter:max(20px, calc((100% - 1080px) / 2));
  margin:0;background:var(--paper);color:var(--ink);font:400 16px/1.6 var(--body);letter-spacing:normal;-webkit-font-smoothing:antialiased;
}
