.vlp .wa{color:var(--saffron);font-weight:700;text-decoration:underline;text-underline-offset:3px}
.vlp .faq .wa{color:var(--terra)}
.vlp .lasts{margin-top:16px;font-size:14.5px;color:var(--on-night-2);text-align:center}
.vlp .lasts b{color:var(--on-night)}
.vlp .offer .btn{margin-top:18px}
.vlp .pay{margin-top:14px;display:grid;gap:4px;text-align:center;font-size:13.5px;color:var(--on-night-2)}
.vlp .pay b{color:var(--saffron)}
.vlp .faq{display:grid;gap:10px}
.vlp details{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:0 16px}
