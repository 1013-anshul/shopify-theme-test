  --saffron:var(--vura-saffron,#FFC03F); --terra:var(--vura-terracotta,#8D3B2D); --terra-tint:var(--vura-terracotta-tint,#F4E9E4); --burgundy:var(--vura-burgundy,#6E1F1A);
  --paper:var(--vura-paper,#F8F3E7); --card:#FBF8F0; --paper-deep:var(--vura-paper-deep,#EDE5D2);
  --ink:var(--vura-paper-ink,#1A2A22); --muted:var(--vura-paper-ink-muted,#4A5750); --line:rgba(26,42,34,.14); --leaf:var(--vura-sage,#637746);
