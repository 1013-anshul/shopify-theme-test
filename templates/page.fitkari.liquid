{%- comment -%}
  Meta ad landing page for the "Don't punish it for sweating" creative. Lives at /pages/fitkari
  (a Page with the "fitkari" template). Hides the store header and footer on this page only,
  and layout/theme.liquid marks it noindex. Uses the site's own type and colour tokens from
  base.css (Bree Serif / Mulish, forest / saffron / paper). Prices, pack images and the review
  count come from the product, so they stay right if the product changes. Photos and the reel
  are theme assets (vlp-*).
{%- endcomment -%}
{%- liquid
  assign vlp_product = all_products['vura-mineral-underarm-spray']
  assign v1 = nil
  assign v3 = nil
  for v in vlp_product.variants
    if v.title contains '1'
      assign v1 = v
    elsif v.title contains '3'
      assign v3 = v
    endif
  endfor

  assign v1_id = v1.id | default: 46001068736746
  assign v3_id = v3.id | default: 46147186458858
  assign v1_cents = v1.price | default: 45000
  assign v3_cents = v3.price | default: 90000
  assign v1_price = v1_cents | money_without_trailing_zeros
  assign v3_price = v3_cents | money_without_trailing_zeros
  assign v3_value = v1_cents | times: 3 | money_without_trailing_zeros
  assign v3_each = v3_cents | divided_by: 3 | money_without_trailing_zeros
  assign v1_rupees = v1_cents | divided_by: 100
  assign v3_rupees = v3_cents | divided_by: 100
  assign v1_daily = v1_cents | divided_by: 6000.0 | floor
  assign v3_daily = v3_cents | divided_by: 18000.0 | floor

  assign rating = vlp_product.metafields.reviews.rating.value.rating | default: 5 | times: 1.0
  assign rating_count = vlp_product.metafields.reviews.rating_count.value | default: vlp_product.metafields.reviews.rating_count | default: 25
  assign rating_1dp = rating | round: 1
  assign rating_label = rating_1dp | append: ''
  unless rating_label contains '.'
    assign rating_label = rating_label | append: '.0'
  endunless

  assign wa = 'https://wa.me/917875697847?text=Hi%20VURA%2C%20I%20have%20a%20question%20about%20the%20fitkari%20spray'
-%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<style>
.shopify-section-group-header-group:not([id$="__cart-drawer"]),.shopify-section-group-footer-group{display:none!important}
#MainContent{padding:0!important}
html{scroll-behavior:smooth}
.vlp{
