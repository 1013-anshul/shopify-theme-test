<script>
(function(){
  var form=document.getElementById('packForm'),buy=document.getElementById('buy'),barBuy=document.getElementById('barBuy'),barPrice=document.getElementById('barPrice'),lasts=document.getElementById('lasts');
  var daily3={{ v3_daily | json }};
  function update(){
    var r=form.querySelector('input:checked'); if(!r) return;
    var price='₹'+Number(r.dataset.price).toLocaleString('en-IN');
    document.querySelectorAll('.vlp .product-variant-id').forEach(function(i){ i.value=r.value; });
    buy.querySelector('span').textContent='Buy '+r.dataset.name+' · '+price;
    barPrice.innerHTML=price+'<small>'+r.dataset.name+' · Free delivery</small>';
    lasts.innerHTML=r.id==='p3'?'Three bottles last about <b>6 months</b>. That’s about ₹'+daily3+' a day.':'One bottle lasts about <b>2 months</b> of daily use.';
  }
  form.addEventListener('change',update); update();

  var bar=document.getElementById('bar'), hero=document.getElementById('heroBtn'), offer=document.getElementById('packs');
  if('IntersectionObserver' in window){
    var seen={hero:false,offer:false};
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ seen[e.target===hero?'hero':'offer']=e.isIntersecting; });
      bar.classList.toggle('away', seen.hero||seen.offer);
    });
    io.observe(hero); io.observe(offer);
  }

  var reel=document.getElementById('reel'), snd=document.getElementById('soundBtn');
  if(reel&&snd){
    snd.addEventListener('click',function(){
      reel.muted=!reel.muted; snd.setAttribute('aria-pressed',String(!reel.muted));
      snd.textContent=reel.muted?'Tap for sound':'Sound on';
      var p=reel.play(); if(p&&p.catch) p.catch(function(){});
    });
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){
        es.forEach(function(e){
          if(e.isIntersecting){ reel.preload='auto'; var p=reel.play(); if(p&&p.catch)p.catch(function(){}); }
          else reel.pause();
        });
      },{threshold:.4,rootMargin:'200px 0px'}).observe(reel);
    }
  }
})();
</script>
