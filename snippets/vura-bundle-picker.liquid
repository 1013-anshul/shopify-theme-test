{% comment %}
  Renders selectable pack-size cards that drive Dawn's native <variant-selects>.
  Each card maps to a real product variant, one card per variant, so the
  correct variant + SKU is what gets added to cart. The native picker is kept in
  the DOM (its engine updates price/availability/[name=id]) but hidden visually.

  Accepts:
  - product: {Object} Product Liquid object

  Usage:
  {% render 'vura-bundle-picker', product: product %}
{% endcomment %}

{%- assign unit_price = product.variants.first.price -%}

{%- comment -%}
  The bottle drawing. Each bottle is inline, not a <use> of one symbol, because
  its label prints (vb-*) turn on their own. Their transform attributes hold the
  front view, which is what shows before the script runs and for reduced motion.
  The shade overlays stay put, so the light holds still while the bottle turns.
{%- endcomment -%}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="vura-bottle-shade" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity=".34"/>
      <stop offset=".2" stop-color="#000" stop-opacity="0"/>
      <stop offset=".28" stop-color="#fff" stop-opacity="0"/>
      <stop offset=".34" stop-color="#fff" stop-opacity=".16"/>
      <stop offset=".42" stop-color="#fff" stop-opacity="0"/>
      <stop offset=".74" stop-color="#000" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity=".4"/>
    </linearGradient>
  </defs>
</svg>
{%- capture vura_bottle -%}
  <svg class="vura-bundle-bottle" viewBox="0 0 16 40" focusable="false">
    <rect x="5" y=".6" width="6" height="5" rx="1.2" fill="#fff"/>
    <rect class="vb-nozzle" x="-.5" y="2.3" width="1" height="1.4" fill="#1A2A22" transform="translate(8 0) scale(1.2 1)"/>
    <rect x="5" y=".6" width="6" height="5" rx="1.2" fill="url(#vura-bottle-shade)" stroke="#1A2A22" stroke-width=".9"/>
    <rect x="2.6" y="5.6" width="10.8" height="6.4" rx="1.6" fill="#fff"/>
    <rect x="2.6" y="5.6" width="10.8" height="6.4" rx="1.6" fill="url(#vura-bottle-shade)" stroke="#1A2A22" stroke-width=".9"/>
    <rect x="1.2" y="12" width="13.6" height="27.4" rx="2.4" fill="#162D24"/>
    <rect class="vb-band" x="-.5" y="16.4" width="1" height="3.6" fill="#FFC03F" transform="translate(8 0) scale(9.2 1)"/>
    <rect class="vb-panel" x="-.5" y="27" width="1" height="7.4" fill="#275341" transform="translate(8 0) scale(9.2 1)"/>
    <g class="vb-back" fill="#F4EFE3" fill-opacity=".6" transform="translate(8 0) scale(0 1)">
      <rect x="-.5" y="16.6" width="1" height=".8"/><rect x="-.5" y="18.8" width="1" height=".8"/><rect x="-.5" y="21" width="1" height=".8"/><rect x="-.5" y="27.4" width="1" height=".8"/><rect x="-.5" y="29.6" width="1" height=".8"/>
    </g>
    <rect x="1.2" y="12" width="13.6" height="27.4" rx="2.4" fill="url(#vura-bottle-shade)"/>
  </svg>
{%- endcapture -%}

<p class="vura-bundle-picker__label">Pack Size</p>
<div class="vura-bundle-picker" data-unit-price="{{ unit_price }}">
  {%- for variant in product.variants -%}
    {%- liquid
      assign count = variant.title | split: '-' | first | times: 1
      if count < 1
        assign count = 1
      endif
      assign was = unit_price | times: count
      assign savings = was | minus: variant.price

      case variant.title
        when '1-Pack'
          assign card_label = 'TRY IT'
        when '2-Pack'
          assign card_label = 'STOCK UP'
        when '3-Pack'
          assign card_label = 'BUY 2 GET 1'
        when '6-Pack'
          assign card_label = 'FAMILY PACK'
        else
          assign card_label = variant.title
      endcase

      assign is_recommended = false
      if variant.title == '3-Pack'
        assign is_recommended = true
      endif

      # Open on the variant Liquid resolves (the 1-Pack, or ?variant= from a link) so the
      # first price a new visitor sees is the entry price. The 3-Pack keeps its badge.
      assign is_default = false
      if variant.id == product.selected_or_first_available_variant.id
        assign is_default = true
      endif

      assign per_bottle = variant.price | divided_by: count

      # Bottles drawn in the card. On the Buy 2 Get 1 pack the third sits in a
      # dashed slot until the card is chosen, then drops in with its Free tag.
      assign free_bottles = 0
      if variant.title == '3-Pack'
        assign free_bottles = 1
      endif
      assign paid_bottles = count | minus: free_bottles | at_most: 6
    -%}
    <label
      class="vura-bundle-card{% if is_default %} vura-bundle-card--selected{% endif %}{% unless variant.available %} vura-bundle-card--soldout{% endunless %}"
      data-variant-id="{{ variant.id }}"
      data-variant-value="{{ variant.title | escape }}"
    >
      <input
        type="radio"
        name="vura-bundle"
        value="{{ variant.id }}"
        class="vura-bundle-radio visually-hidden"
        {% if is_default %}checked{% endif %}
      >
      <span class="vura-bundle-card__corner">
        <span class="vura-bundle-card__tag{% if is_recommended %} vura-bundle-card__tag--gold{% endif %}">{{ card_label }}</span>
        {%- if is_recommended -%}<span class="vura-bundle-card__tag vura-bundle-card__tag--dark">RECOMMENDED</span>{%- endif -%}
      </span>
      {%- capture bottles -%}
        <span class="vura-bundle-bottles" aria-hidden="true">
          {%- for i in (1..paid_bottles) -%}
            {{- vura_bottle -}}
          {%- endfor -%}
          {%- if free_bottles > 0 -%}
            <span class="vura-bundle-free">
              <svg class="vura-bundle-free__ghost" viewBox="0 0 16 40"><path d="M5.4 1.2H10.6V6H13V12.4H14.4V38.8H1.6V12.4H3V6H5.4Z" fill="none" stroke="#1A2A22" stroke-opacity=".35" stroke-width=".9" stroke-dasharray="2 1.6" stroke-linejoin="round"/></svg>
              {{- vura_bottle | replace: 'class="vura-bundle-bottle"', 'class="vura-bundle-bottle vura-bundle-free__bottle"' -}}
              <span class="vura-bundle-free__tag">Free</span>
            </span>
          {%- endif -%}
        </span>
      {%- endcapture -%}
      {%- liquid
        # Multi-packs carry the bottles on their Save / per-bottle row, where there
        # is spare width, so the name and price line keeps the full card width.
        assign has_meta = false
        if savings > 0 or count > 1 and variant.available
          assign has_meta = true
        endif
      -%}
      <div class="vura-bundle-card__inner">
        <span class="vura-bundle-card__radio" aria-hidden="true"></span>
        <div class="vura-bundle-card__body">
          <span class="vura-bundle-card__qty">{{ variant.title }}</span>
          <span class="vura-bundle-card__price">{{ variant.price | money }}</span>
          {%- if savings > 0 and variant.available -%}
            <span class="vura-bundle-card__was"><s>{{ was | money }}</s></span>
          {%- endif -%}
          {%- unless variant.available -%}
            <span class="vura-bundle-card__soldout">Sold out</span>
          {%- endunless -%}
          {%- if has_meta -%}
            <span class="vura-bundle-card__meta-row">
              {%- if savings > 0 and variant.available -%}
                <span class="vura-bundle-card__savings">Save {{ savings | money }}</span>
              {%- endif -%}
              {%- if count > 1 and variant.available -%}
                <span class="vura-bundle-card__per">{{ per_bottle | money_without_trailing_zeros }}/bottle</span>
              {%- endif -%}
              {{- bottles -}}
            </span>
          {%- endif -%}
        </div>
        {%- unless has_meta -%}{{- bottles -}}{%- endunless -%}
      </div>
    </label>
  {%- endfor -%}
</div>

<style>
  /* The native Pack Size picker still powers price/availability — keep it in the
     DOM but hidden; these cards are the visible selector. */
  variant-selects {
    display: none !important;
  }
  /* This snippet lives inside Dawn's .product-form__quantity wrapper (repurposed
     to hold pack cards instead of a qty stepper), which Dawn caps at max-width:
     44rem (~462px) — narrower than the rest of the info column, which is why
     the offer banner above it looked wider than the cards below it. Only lift
     the cap on the wrapper that actually holds this picker. */
  .product-form__quantity:has(.vura-bundle-picker) {
    max-width: none;
  }
  .vura-bundle-picker__label {
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: var(--vura-paper-ink, #1A2A22);
    margin: 1.5rem 0 0.6rem;
  }
  .vura-bundle-picker {
    display: grid;
    /* Always one card per row, full width — matches the reference design.
       A side-by-side grid squeezed each card's corner badges into the next
       card's, which is what caused them to overlap on desktop. */
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 0 0 1.5rem;
  }
  .vura-bundle-card {
    position: relative;
    cursor: pointer;
    border: 1.5px solid rgba(26,42,34,0.16);
    border-radius: 14px;
    background: #fff;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    overflow: visible;
  }
  .vura-bundle-card:hover {
    border-color: rgba(99,119,70,0.4);
  }
  .vura-bundle-card--selected {
    border-color: var(--vura-forest-deep, #0E2118);
    border-width: 2px;
    background: var(--vura-paper-deep, #EDE5D2);
  }
  /* Corner tags — a small row of pill badges overlapping the card's top-right
     border, one per card ("TRY IT" etc.) plus an extra "RECOMMENDED" tag on
     the featured pack. */
  .vura-bundle-card__corner {
    position: absolute;
    top: -9px;
    right: 12px;
    display: flex;
    gap: 6px;
    z-index: 1;
  }
  .vura-bundle-card__tag {
    background: var(--vura-forest-deep, #0E2118);
    color: #fff;
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 11px;
    border-radius: 99px;
    white-space: nowrap;
    line-height: 1.4;
  }
  .vura-bundle-card__tag--gold {
    background: var(--vura-saffron, #FFC03F);
    color: var(--vura-forest-deep, #0E2118);
  }
  .vura-bundle-card__tag--dark {
    background: var(--vura-forest-deep, #0E2118);
    color: #fff;
  }
  .vura-bundle-card__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    padding: 18px 18px;
    min-height: 64px;
  }
  .vura-bundle-card__radio {
    display: block;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid rgba(26,42,34,0.25);
    background: #fff;
    position: relative;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  .vura-bundle-card--selected .vura-bundle-card__radio {
    border-color: var(--vura-forest-deep, #0E2118);
    background: var(--vura-forest-deep, #0E2118);
  }
  .vura-bundle-card--selected .vura-bundle-card__radio::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 7px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: translate(-50%, -60%) rotate(-45deg);
  }
  .vura-bundle-card__body {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .vura-bundle-card__qty {
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 18px;
    font-weight: 700;
    color: #1A2A22;
    line-height: 1.3;
  }
  .vura-bundle-card__price {
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 16px;
    font-weight: 600;
    color: #1A2A22;
  }
  .vura-bundle-card__was {
    font-size: 12px;
    color: #7A857F;
  }
  .vura-bundle-card__was s {
    text-decoration: line-through;
  }
  /* Savings + per-bottle price always sit together on their own row, as a
     group, regardless of how much horizontal room the card has — the two
     used to only fall onto separate lines by accident when the column was
     narrow. */
  .vura-bundle-card__meta-row {
    flex-basis: 100%;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .vura-bundle-card__per {
    font-size: 12px;
    color: var(--text-on-paper-muted, #4A5750);
  }
  .vura-bundle-card__savings {
    display: inline-block;
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: #3D4B22;
    background: rgba(99,119,70,0.12);
    padding: 2px 8px;
    border-radius: 99px;
    margin-top: 4px;
  }
  .vura-bundle-card__soldout {
    display: inline-block;
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9A5B4E;
    margin-top: 4px;
  }
  .vura-bundle-card--soldout {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .vura-bundle-card--soldout:hover {
    border-color: rgba(26,42,34,0.12);
  }

  /* Bottles sit at the right edge of each card: beside the name on the 1-Pack,
     at the end of the Save / per-bottle row on multi-packs. */
  .vura-bundle-card__body {
    flex: 1;
    min-width: 0;
  }
  .vura-bundle-bottles {
    margin-left: auto;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }
  .vura-bundle-card__meta-row:has(.vura-bundle-bottles) {
    align-items: flex-end;
  }
  .vura-bundle-bottle {
    display: block;
    width: 13.6px;
    height: 34px;
  }
  .vura-bundle-free {
    position: relative;
    display: block;
    width: 13.6px;
    height: 34px;
  }
  .vura-bundle-free > svg {
    position: absolute;
    inset: 0;
  }
  .vura-bundle-free__ghost { transition: opacity 0.2s ease; }
  .vura-bundle-free__bottle { opacity: 0; }
  .vura-bundle-card--selected .vura-bundle-free__ghost { opacity: 0; }
  .vura-bundle-card--selected .vura-bundle-free__bottle { opacity: 1; }
  /* Before the 3-Pack is chosen the tag is a dashed outline over the empty
     slot; once chosen it fills with saffron. */
  .vura-bundle-free__tag {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 3px);
    transform: translateX(-50%);
    font-family: var(--font-body, Mulish, sans-serif);
    font-size: 8px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 3px 4px 2px;
    border-radius: 3px;
    border: 1px dashed rgba(26,42,34,0.35);
    color: #4A5750;
    background: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .vura-bundle-card--selected .vura-bundle-free__tag {
    border: 1px solid var(--vura-saffron, #FFC03F);
    background: var(--vura-saffron, #FFC03F);
    color: var(--vura-forest-deep, #0E2118);
  }
  @media (prefers-reduced-motion: reduce) {
    .vura-bundle-free__ghost,
    .vura-bundle-free__tag { transition: none; }
  }

  /* Enforce clean standard borders on unselected cards to clear highlight */
  .vura-bundle-card:not(.vura-bundle-card--selected) {
    border: 1.5px solid rgba(26,42,34,0.16) !important;
    background: #fff !important;
  }
</style>

<script>
  (function() {
    const picker = document.querySelector('.vura-bundle-picker');
    if (!picker) return;

    const cards = picker.querySelectorAll('.vura-bundle-card');

    // The native Dawn variant picker (drives price / [name=id] / availability).
    function getVariantSelects() {
      return document.querySelector('variant-selects');
    }

    // Force a quantity of 1 — pack size is now the variant, not the quantity.
    function setQuantityOne() {
      const qtyInput =
        document.querySelector('.product-form__quantity input[name="quantity"]') ||
        document.querySelector('input[name="quantity"]');
      if (qtyInput) qtyInput.value = 1;
      const stickyQty = document.getElementById('StickyQtyInput');
      if (stickyQty) stickyQty.value = 1;
    }

    // Select a variant by its option value ("1-Pack" / "3-Pack" / "6-Pack") by
    // checking the matching native radio and firing change so Dawn updates.
    function selectVariant(value) {
      const vs = getVariantSelects();
      if (!vs) return;
      const inputs = vs.querySelectorAll('input[type="radio"], option');
      for (let i = 0; i < inputs.length; i++) {
        if (inputs[i].value === value) {
          const el = inputs[i];
          if (el.tagName === 'OPTION') {
            const select = el.closest('select');
            if (select) {
              select.value = value;
              select.dispatchEvent(new Event('change', { bubbles: true }));
            }
          } else if (!el.checked) {
            el.checked = true;
            el.dispatchEvent(new Event('change', { bubbles: true }));
          }
          break;
        }
      }
    }

    // Free bottle motion. The card classes set where everything rests; these
    // animations only play the move between states, so reduced motion (or a
    // browser without element.animate) simply gets the resting state.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canAnimate = () => !calm.matches && typeof Element.prototype.animate === 'function';

    // A damped spring, 1 - e^(-8t)·cos(10t): lands at 160 ms, overshoots about
    // 3 px, settled by 0.5 s. Sampled into keyframes so every browser plays
    // the same curve.
    function dropFrames(from) {
      const frames = [];
      for (let i = 0; i <= 24; i++) {
        const t = (i / 24) * 0.6;
        const s = 1 - Math.exp(-8 * t) * Math.cos(10 * t);
        frames.push({ transform: `translateY(${(from * (1 - s)).toFixed(2)}px)`, opacity: Math.min(1, t / 0.06), offset: i / 24 });
      }
      return frames;
    }

    // Cancels whatever the last tap started, so rapid switching never stacks
    // a lift-out under a drop-in.
    function freeParts(card) {
      const bottle = card && card.querySelector('.vura-bundle-free__bottle');
      if (!bottle) return null;
      const tag = card.querySelector('.vura-bundle-free__tag');
      bottle.getAnimations().concat(tag.getAnimations()).forEach(a => a.cancel());
      return { bottle, tag };
    }

    function playDropIn(card) {
      const p = freeParts(card);
      if (!p || !canAnimate()) return;
      p.bottle.animate(dropFrames(-28), { duration: 600, easing: 'linear' });
      p.tag.animate(
        [{ transform: 'translateX(-50%) scale(1.35)', opacity: 0 }, { transform: 'translateX(-50%) scale(1)', opacity: 1 }],
        { duration: 200, delay: 260, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'backwards' }
      );
    }

    function playLiftOut(card) {
      const p = freeParts(card);
      if (!p || !canAnimate()) return;
      p.bottle.animate(
        [{ transform: 'translateY(0)', opacity: 1 }, { transform: 'translateY(-16px)', opacity: 0 }],
        { duration: 160, easing: 'cubic-bezier(0.5, 0, 0.75, 0)' }
      );
    }

    function selectCard(card) {
      if (card.classList.contains('vura-bundle-card--soldout')) return;
      // Tapping a <label> also clicks its radio, so this runs twice per tap;
      // only the first call sees a change and plays anything.
      const prev = picker.querySelector('.vura-bundle-card--selected');
      cards.forEach(c => c.classList.remove('vura-bundle-card--selected'));
      card.classList.add('vura-bundle-card--selected');
      if (prev && prev !== card) {
        playLiftOut(prev);
        playDropIn(card);
      }
      const radio = card.querySelector('.vura-bundle-radio');
      if (radio) radio.checked = true;
      selectVariant(card.dataset.variantValue);
      setQuantityOne();
    }

    cards.forEach(card => {
      card.addEventListener('click', function () { selectCard(this); });
    });

    // Turntable: every bottle turns in place, one turn every 4.5 s. A cylinder has
    // the same outline from every side, so only the label prints move: each is
    // projected onto the body as it goes round, narrowing at the edges and
    // passing behind, and the back label comes round when the front turns away.
    // [radius, half-width of the print, facing: 0 front / PI back] in viewBox units.
    const TURN = 4500;
    const PRINTS = { 'vb-band': [6.8, 4.6, 0], 'vb-panel': [6.8, 4.6, 0], 'vb-nozzle': [3, 0.6, 0], 'vb-back': [6.8, 3.8, Math.PI] };
    function turnFrames([r, hw, face]) {
      const a = Math.asin(Math.min(1, hw / r));
      const frames = [];
      for (let i = 0; i <= 72; i++) {
        let c = face + (i / 72) * 2 * Math.PI;
        c = Math.atan2(Math.sin(c), Math.cos(c));
        const lo = Math.max(c - a, -Math.PI / 2), hi = Math.min(c + a, Math.PI / 2);
        const xl = 8 + r * Math.sin(lo), xr = 8 + r * Math.sin(hi);
        const w = hi > lo ? xr - xl : 0;
        frames.push({ transform: `translate(${((xl + xr) / 2).toFixed(3)}px, 0px) scale(${w.toFixed(3)}, 1)`, offset: i / 72 });
      }
      return frames;
    }
    if (canAnimate()) {
      const spins = [];
      for (const k in PRINTS) {
        const frames = turnFrames(PRINTS[k]);
        picker.querySelectorAll('.vura-bundle-bottles').forEach(row => {
          row.querySelectorAll('.vura-bundle-bottle').forEach((bottle, i) => {
            bottle.querySelectorAll('.' + k).forEach(el => {
              const spin = el.animate(frames, { duration: TURN, iterations: Infinity });
              // Each bottle runs 5% of a turn behind the one on its left, so a row turns as a ripple.
              spin.currentTime = (TURN - i * TURN * 0.05) % TURN;
              spins.push(spin);
            });
          });
        });
      }
      // Only turn while the cards are on screen.
      new IntersectionObserver(entries => {
        const visible = entries[entries.length - 1].isIntersecting;
        spins.forEach(s => (visible ? s.play() : s.pause()));
      }).observe(picker);
    }

    // Re-apply the default selection once Dawn's variant engine is ready.
    const defaultSelected = picker.querySelector('.vura-bundle-card--selected');
    if (defaultSelected) {
      setTimeout(function () { selectCard(defaultSelected); }, 300);
    }
  })();
</script>
