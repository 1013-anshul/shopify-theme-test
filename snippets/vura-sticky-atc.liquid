{%- comment -%}
  VURA Sticky Add-to-Cart Bar
  Renders a fixed bottom bar on product pages that is always visible on page load.
  Shows product image, name, price, and a pill-shaped Add to Cart CTA.
  Pack size is chosen via the pack cards; quantity stays 1 (adjust in the cart).
{%- endcomment -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    # A visitor arriving from an ad sees this bar before they have scrolled far
    # enough to reach the pack cards, so it has to say what the price buys — a
    # bare multi-pack price reads as the price of a single bottle.
    assign unit_price = product.variants.first.price
    assign sel = product.selected_or_first_available_variant
    assign sel_count = sel.title | split: '-' | first | times: 1
    if sel_count < 1
      assign sel_count = 1
    endif
    assign sel_was = unit_price | times: sel_count
    assign sel_savings = sel_was | minus: sel.price
  -%}
  <style>
    .vura-sticky-atc__inner,
    .vura-sticky-atc__btn { transition: padding 0.25s ease, height 0.25s ease, font-size 0.25s ease; }

    /* The bar is position: fixed, so the layout reserves no space for it and it
       covers the last ~120px of the page. JS refines this to the measured height. */
    body { padding-bottom: 120px; }

    .vura-sticky-atc__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 6px; }
    .vura-sticky-atc__packname { font-weight: 700; }
    .vura-sticky-atc__packname::after { content: "·"; margin-left: 6px; opacity: 0.45; font-weight: 400; }
    .vura-sticky-atc__save {
      font-size: 10px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
      color: #3D4B22; background: rgba(99,119,70,0.14);
      padding: 1px 6px; border-radius: 99px; white-space: nowrap;
    }
    .vura-sticky-atc__save:empty { display: none; }
    .vura-sticky-atc.vura-sticky-atc--minimized .vura-sticky-atc__image,
    .vura-sticky-atc.vura-sticky-atc--minimized .vura-sticky-atc__info { display: none !important; }
    .vura-sticky-atc.vura-sticky-atc--minimized .vura-sticky-atc__inner { padding: 8px 16px !important; justify-content: center !important; gap: 12px !important; }
    .vura-sticky-atc.vura-sticky-atc--minimized .vura-sticky-atc__btn { height: 34px !important; padding: 0 20px !important; font-size: 11px !important; flex: 1 !important; }
  </style>
  <div class="vura-sticky-atc is-visible" id="VuraStickyAtc">
    <div class="vura-sticky-atc__inner">
      <div class="vura-sticky-atc__left">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 120, height: 120, crop: 'center' }}" alt="{{ product.title | escape }}" class="vura-sticky-atc__image" width="60" height="60" loading="lazy">
        {%- endif -%}
        <div class="vura-sticky-atc__info">
          <div class="vura-sticky-atc__title">{{ product.title }}</div>
          <div class="vura-sticky-atc__price">
            {%- unless product.has_only_default_variant -%}
              <span class="vura-sticky-atc__packname">{{ sel.title }}</span>
            {%- endunless -%}
            <span class="vura-sticky-atc__amount">{{ sel.price | money }}</span>
            <span class="vura-sticky-atc__save">
              {%- if sel_savings > 0 and sel.available -%}Save {{ sel_savings | money }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      
      <div class="vura-sticky-atc__actions">
        <button
          type="button"
          class="vura-sticky-atc__btn btn-press"
          id="VuraStickyAtcBtn"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          <span>
            {%- if product.selected_or_first_available_variant.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var bar = document.getElementById('VuraStickyAtc');
      var btn = document.getElementById('VuraStickyAtcBtn');
      if (!bar || !btn) return;

      // Ensure the bar is always visible by default
      bar.classList.add('is-visible');

      // Reserve the bar's real height at the end of the page. Measured only while
      // the bar is at full height — the minimized state is shorter, and shrinking
      // the reserve on scroll would move the page under the reader.
      function reserveBarSpace() {
        if (bar.classList.contains('vura-sticky-atc--minimized')) return;
        document.body.style.paddingBottom = bar.offsetHeight + 'px';
      }
      reserveBarSpace();
      window.addEventListener('resize', reserveBarSpace);

      // Shrink (hide image) on scroll down, restore to full size on scroll up.
      // Self-contained here so it works regardless of global.js execution.
      var lastScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
      window.addEventListener('scroll', function() {
        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
        if (y > lastScrollY && y > 150) {
          bar.classList.add('vura-sticky-atc--minimized');
        } else if (y < lastScrollY) {
          bar.classList.remove('vura-sticky-atc--minimized');
        }
        lastScrollY = y;
      }, { passive: true });

      // Click handler: find and click the real Add to Cart button
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var realBtn = document.querySelector('.product-form__submit');
        if (realBtn && !realBtn.disabled) {
          realBtn.click();

          // Brief visual feedback
          btn.style.opacity = '0.7';
          btn.querySelector('span').textContent = 'Adding...';
          setTimeout(function() {
            btn.style.opacity = '1';
            btn.querySelector('span').textContent = 'Add to Cart';
          }, 1200);
        }
      });

      // Keep the sticky price + availability in sync with the selected pack variant.
      var VURA_VARIANTS = {
        {%- for v in product.variants -%}
          {%- liquid
            assign count = v.title | split: '-' | first | times: 1
            if count < 1
              assign count = 1
            endif
            assign was = unit_price | times: count
            assign savings = was | minus: v.price
          -%}
          "{{ v.id }}": {
            priceMoney: {{ v.price | money | json }},
            packName: {{ v.title | json }},
            savingsMoney: {%- if savings > 0 -%}{{ savings | money | prepend: 'Save ' | json }}{%- else -%}""{%- endif -%},
            available: {{ v.available | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      };
      function getSelectedVariantId() {
        // Read the tapped pack card (set synchronously by the bundle picker) — this avoids the
        // race where [name="id"] is updated by Dawn's async fetch only after our listener runs.
        var card = document.querySelector('.vura-bundle-card--selected');
        if (card && card.getAttribute('data-variant-id')) return card.getAttribute('data-variant-id');
        var idInput = document.querySelector('[name="id"]');
        return idInput ? idInput.value : null;
      }
      function updateStickyFromVariant() {
        var id = getSelectedVariantId();
        if (!id || !VURA_VARIANTS[id]) return;
        var v = VURA_VARIANTS[id];
        var amountEl = bar.querySelector('.vura-sticky-atc__amount');
        var packEl = bar.querySelector('.vura-sticky-atc__packname');
        var saveEl = bar.querySelector('.vura-sticky-atc__save');
        if (amountEl) amountEl.textContent = v.priceMoney;
        if (packEl) packEl.textContent = v.packName;
        if (saveEl) saveEl.textContent = v.savingsMoney;
        var span = btn.querySelector('span');
        if (v.available) {
          btn.disabled = false;
          if (span && span.textContent === 'Sold Out') span.textContent = 'Add to Cart';
        } else {
          btn.disabled = true;
          if (span) span.textContent = 'Sold Out';
        }
      }
      document.addEventListener('change', function(e) {
        if (e.target && e.target.closest && e.target.closest('variant-selects')) {
          setTimeout(updateStickyFromVariant, 60);
        }
      });
      // Update the instant a pack card is tapped (bundle picker sets --selected first).
      document.addEventListener('click', function(e) {
        if (e.target && e.target.closest && e.target.closest('.vura-bundle-card')) {
          setTimeout(updateStickyFromVariant, 0);
        }
      });
      // Initial pass once the bundle picker has applied its default variant.
      setTimeout(updateStickyFromVariant, 500);
    })();
  </script>
{%- endif -%}
